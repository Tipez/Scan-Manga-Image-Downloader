{
  "manifest_version": 3,
  "name": "Scan Manga Image Downloader – Fast JPG/PNG Saver",
  "version": "1.0",
  "description": "🇬🇧 Scan Manga Image Downloader – Download .jpg and .png images from scan-manga.com.",
  "permissions": ["downloads","activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["popup.js"],
      "run_at": "document_idle"
    }
  ]
}
